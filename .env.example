# Postgres connection string (matches docker-compose.yml service below)
# NOTE: host port 5433 (not 5432) to avoid clashing with any local Postgres install
DATABASE_URI=postgresql://payload:payload@127.0.0.1:5433/my-cms-site

# Used to encrypt JWT tokens - generate a long random string for production
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Used to configure CORS, format links and more. No trailing slash
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Secret used to authenticate cron jobs
CRON_SECRET=YOUR_CRON_SECRET_HERE

# Used to validate preview requests
PREVIEW_SECRET=YOUR_SECRET_HERE

# AWS S3 (optional) — used both to store new Media uploads (images + podcast MP3s)
# and to serve hundreds of existing MP3s already hosted in the bucket.
# Leave S3_BUCKET unset to keep using local disk storage (public/media) in development.
S3_BUCKET=YOUR_BUCKET_NAME
S3_ACCESS_KEY_ID=YOUR_AWS_ACCESS_KEY_ID
S3_SECRET_ACCESS_KEY=YOUR_AWS_SECRET_ACCESS_KEY
S3_REGION=us-east-1
# Optional: only needed for S3-compatible providers (e.g. Cloudflare R2, MinIO) or custom endpoints.
# S3_ENDPOINT=https://s3.us-east-1.amazonaws.com

# --- Email ---
# Chooses which provider Payload's email adapter (and the sendEmail() helper) uses.
# "nodemailer" (default) = native SMTP. "sendgrid" = SendGrid API.
EMAIL_PROVIDER=nodemailer
EMAIL_FROM_NAME=My CMS Site
EMAIL_FROM_ADDRESS=no-reply@example.com

# Required only when EMAIL_PROVIDER=sendgrid
SENDGRID_API_KEY=YOUR_SENDGRID_API_KEY

# Required only when EMAIL_PROVIDER=nodemailer (works with Gmail, Outlook, cPanel, etc.)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=YOUR_SMTP_USERNAME
SMTP_PASS=YOUR_SMTP_PASSWORD
# true for port 465 (implicit TLS), false for 587/25 (STARTTLS)
SMTP_SECURE=false

